{
  "name": "tm-glicko",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/services/website/input.css -o public/site.css --minify",
    "start": "bun run src/index.ts",
    "import-db": "bun run scripts/importLocalDatabase.ts",
    "test": "bun run build:css && bun test --parallel --timeout 30000",
    "test:cov": "bun run build:css && bun test --coverage --parallel --timeout 30000",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.4",
    "glicko2.ts": "^1.3.2",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}